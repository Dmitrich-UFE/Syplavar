  _Description: "\u0424\u0438\u043D\u0430\u043B \u0436\u0435, \u0434\u0430?"
  _GoalDescription: "\u0422\u0337\u0305\u0313\u030C\u0309\u0352\u030C\u0352\u0305\u033F\u030B\u033D\u0310\u030C\u0358\u0350\u030A\u035D\u0311\u0344\u033E\u030F\u0316\u034D\u032C\u033C\u031D\u044B\u0336\u034A\u0360\u035D\u034B\u034A\u0309\u034B\u0357\u0323\u0332\u0356\u0325\u0333\u0331\u031E\u032C\u0356\u0355\u031C\u0319\u0356\u0316\u0317\u031D\u031D\u033C\u0345
    \u0335\u0342\u035D\u0341\u033F\u0305\u0312\u033E\u0300\u0355\u035A\u0349\u0317\u033A\u0339\u035A\u0359\u031E\u0348\u0326\u0318\u0333\u032D\u0339\u033C\u0323\u0436\u0336\u0311\u0307\u0310\u0315\u030A\u0342\u0303\u0314\u0350\u0306\u0356\u0359\u034E\u032B\u0324\u0330\u033A\u0323\u0435\u0338\u0301\u030F\u0358\u035D\u0344\u0342\u0351\u0313\u0311\u033F\u0309\u035D\u030B\u034A\u035B\u030F\u0343\u033F\u030F\u0357\u0325\u0328\u0356\u0333\u031E\u0345\u0356\u031C\u032D\u0354\u0354\u035A\u031E\u032F\u032A\u0322\u0330\u034E\u032B\u0330\u0317\u0331\u033B
    \u0337\u0358\u0344\u030E\u0308\u0314\u030D\u0300\u0305\u034B\u030D\u0344\u0315\u0358\u030B\u0339\u032F\u034E\u034E\u0326\u0320\u0328\u031E\u031C\u0316\u0349\u032F\u034D\u032B\u033A\u0324\u043E\u0338\u0309\u034A\u0351\u030A\u0312\u0315\u030F\u030C\u0309\u030C\u0358\u034C\u0303\u0304\u0360\u034C\u035D\u033E\u0360\u0306\u0328\u032D\u0355\u0356\u032A\u035A\u032D\u031F\u0317\u0324\u0326\u031E\u0325\u0441\u0336\u030F\u034A\u035D\u0302\u034C\u0302\u0342\u0346\u0352\u0309\u031A\u0310\u0315\u033F\u0313\u0313\u0315\u0358\u0313\u034B\u0358\u032A\u031C\u0354\u0348\u0324\u031E\u0320\u033C\u0327\u0355\u033C\u0325\u0328\u0442\u0334\u0352\u0342\u031A\u0304\u033D\u0340\u032A\u0430\u0334\u0358\u035D\u0360\u034B\u0342\u0340\u033D\u033F\u035D\u0303\u0316\u0354\u043D\u0338\u0306\u030F\u0312\u0300\u0346\u033E\u0310\u0346\u031A\u0300\u033F\u0311\u034B\u0313\u0326\u0330\u032C\u0435\u0335\u0308\u0313\u0344\u030F\u0343\u0341\u031B\u034B\u031A\u0358\u0312\u030E\u0311\u034C\u035D\u0357\u035B\u0315\u0310\u0358\u0330\u032D\u032E\u0327\u0355\u0320\u0319\u033C\u035C\u032C\u0348\u0321\u034E\u032B\u0325\u033B\u0322\u0318\u031C\u033A\u0316\u035C\u0317\u0448\u0336\u031A\u034C\u034A\u0346\u0314\u0344\u0352\u0306\u0352\u0358\u031B\u0305\u0324\u032A\u034E\u0329\u031C\u0330\u0330\u044C\u0335\u033E\u0346\u0305\u0314\u030A\u0351\u0313\u034B\u0304\u0312\u032F\u0353\u0359\u0320\u0333\u034E\u032E\u0349\u0345\u0316\u0328\u0328\u0318\u032B\u0322\u032B\u0330\u0323\u032A\u0316\u0323\u0324\u0326\u0441\u0334\u0310\u0315\u0315\u0310\u030D\u0314\u0310\u0351\u0305\u035B\u031B\u0342\u0360\u030A\u030E\u033D\u035B\u034A\u0327\u033A\u034E\u0339\u0326\u0321\u032E\u035C\u0330\u0359\u033C\u0349\u0345\u032F\u044F\u0335\u0357\u034A\u035B\u0300\u035B\u030F\u0313\u0360\u0308\u031A\u033D\u0350\u0351\u030E\u0341\u0312\u030F\u035D\u0357\u035C\u0354\u0355\u0332\u034E\u032C\u033B\u0316\u035A\u0327
