  _Name: "\u041D\u0430\u0447\u0430\u043B\u043E"
  _Description: "\u0412\u044B \u043F\u0440\u0438\u0431\u044B\u0432\u0430\u0435\u0442\u0435
    \u043D\u0430 \u0444\u0435\u0440\u043C\u0443, \u043F\u043E\u043B\u0443\u0447\u0435\u043D\u043D\u0443\u044E
    \u043E\u0442 \u0442\u043E\u0433\u043E \u0441\u0430\u043C\u043E\u0433\u043E \u0434\u0430\u043B\u044C\u043D\u0435\u0433\u043E
    \u0440\u043E\u0434\u0441\u0442\u0432\u0435\u043D\u043D\u0438\u043A\u0430. \u041F\u0440\u0438\u043A\u043B\u044E\u0447\u0435\u043D\u0438\u044F
    \u043D\u0430\u0447\u0438\u043D\u0430\u044E\u0442\u0441\u044F.."
  _GoalDescription: "\u041F\u043E\u0434\u043E\u0439\u0434\u0438\u0442\u0435 \u043A
    \u043A\u0430\u043B\u0438\u0442\u043A\u0435"
