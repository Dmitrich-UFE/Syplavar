    - target: {fileID: 5911126516353569100, guid: 67703b64dffe1b14db851722d10868c4, type: 3}
      propertyPath: m_text
      value: "WASD - \u043F\u0435\u0440\u0435\u043C\u0435\u0449\u0435\u043D\u0438\u0435\n\u043B\u0435\u0432\u044B\u0439
        Shift - \u0431\u0435\u0433\n\u041F\u041A\u041C - \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435
        \u0441 \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u043E\u043C\n\u041B\u041A\u041C
        - \u0430\u0442\u0430\u043A\u0430\n\u0421\u041A\u041C \u0438\u043B\u0438 0-9
        - \u043D\u0430\u0432\u0438\u0433\u0430\u0446\u0438\u044F \u043F\u043E \u0438\u043D\u0432\u0435\u043D\u0442\u0430\u0440\u044E\nE
        - \u043E\u0442\u043A\u0440\u044B\u0442\u044C/\u0437\u0430\u043A\u0440\u044B\u0442\u044C
        \u0438\u043D\u0432\u0435\u043D\u0442\u0430\u0440\u044C\nEsc - \u043E\u0442\u043A\u0440\u044B\u0442\u044C
        \u043C\u0435\u043D\u044E \u043F\u0430\u0443\u0437\u044B"
