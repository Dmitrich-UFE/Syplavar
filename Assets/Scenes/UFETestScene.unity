  _ID: 29
  _Name: "\u041F\u0438\u0440 \u043D\u0430 \u0432\u0435\u0441\u044C \u043C\u0438\u0440"
  _Description: "\u0412\u044B \u0442\u0430\u043A\u0442\u0438\u0447\u0435\u0441\u043A\u0438
    \u0441\u0431\u0435\u0436\u0430\u043B\u0438 \u043E\u0431\u0440\u0430\u0442\u043D\u043E
    \u043D\u0430 \u0444\u0435\u0440\u043C\u0443, \u0432\u0435\u0434\u044C \u0432\u044B
    \u0434\u043E \u0441\u0438\u0445 \u043F\u043E\u0440 \u0433\u043E\u043B\u043E\u0434\u043D\u044B
    \u0438 \u043D\u0435 \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u044B \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C
    \u0437\u0434\u043E\u0440\u043E\u0432\u044C\u0435. \u0414\u0430\u0432\u0430\u0439\u0442\u0435
    \u044D\u0442\u043E \u0438\u0441\u043F\u0440\u0430\u0432\u0438\u043C!"
  _GoalDescription: "\u0421\u0434\u0435\u043B\u0430\u0439\u0442\u0435 \u0447\u0442\u043E-\u043D\u0438\u0431\u0443\u0434\u044C
    \u0441\u044A\u0435\u0441\u0442\u043D\u043E\u0435 \u0438\u0437 \u0432\u044B\u0440\u0430\u0449\u0435\u043D\u043D\u044B\u0445
    \u0440\u0430\u0441\u0442\u0435\u043D\u0438\u0439"
